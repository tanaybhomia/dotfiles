# Separate light & dark theme
theme = light:Adwaita,dark:Adwaita Dark

# Font and Cursors
font-family = "CaskaydiaCove Nerd Font"
# font-family = "Paper Mono"
font-size = 12
font-style = "Medium"
cursor-style = "block_hollow"

# Window
window-padding-x = 7
window-padding-y = 3
gtk-titlebar-style = tabs
window-height = 44
window-width = 112
window-position-x = 50
window-position-y = 50

# Keybindings
keybind = ctrl+w=close_surface
keybind = ctrl+t=new_tab
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+o=toggle_tab_overview
#keybind = ctrl+'=goto:split_right
#keybind = ctrl+;=goto:split_left
keybind = ctrl+c=copy_to_clipboard:mixed
