# Separate light & dark theme
theme = light:Adwaita,dark:Adwaita Dark

# Font and Cursors
font-family = "CaskaydiaCove Nerd Font"
# font-family = "Paper Mono"
font-size = 12
font-style = "Medium"
cursor-style = "block_hollow"
mouse-hide-while-typing = true

# Window & GNOME Integration
window-padding-x = 7
window-padding-y = 3
gtk-titlebar-style = tabs
window-show-tab-bar = auto
window-height = 44
window-width = 112

# Terminal Workflow & Quality of Life
scrollback-limit = 100000
clipboard-trim-trailing-spaces = true
clipboard-read = "ask"
clipboard-write = "allow"
confirm-close-surface = true
bell-features = no-system,no-audio

# Keybindings (Tabs & Clipboard)
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+o=toggle_tab_overview
keybind = ctrl+c=copy_to_clipboard:mixed

# Keybindings (Native Splits)
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:top
keybind = alt+down=goto_split:bottom
keybind = ctrl+shift+z=toggle_split_zoom
